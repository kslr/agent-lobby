{
  "name": "agent-lobby",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A plugin that shows your agents as a small pixel-art office: who is working, who is waiting for you, who has finished.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "agents",
    "lobby",
    "office",
    "pixel-art"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.2",
    "@getpaseo/plugin": "0.11.2",
    "@getpaseo/protocol": "0.11.2",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
